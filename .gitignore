# Keep local manuals private; publish only explicitly reviewed repository rules.
/docs/*
!/docs/UI_ARCHITECTURE.md
!/docs/WORKSPACE.md
!/docs/ARCHITECTURE.md
!/docs/KIT_INTEGRATION.md
!/docs/DEVELOPMENT.md
!/docs/migrations/
/docs/migrations/*
!/docs/migrations/kit-extraction-v2.md
/AGENTS.md
/*.md
!/README.md
!/AGENTS.md

# Read-only legacy implementation
/legacy/

# Temporary upstream source checkouts used for provenance review
/.tmp-*/

# Rust build output
/target/
**/*.rs.bk
__pycache__/

# Local tooling and editor state
/.vs/
/.vscode/
/.idea/
*.suo
*.user
*.userosscache
*.sln.docstates

# Operating-system metadata
.DS_Store
Thumbs.db
Desktop.ini

# Logs and local environment files
*.log
.env
.env.*
!.env.example
